{
  "id": "example-panel",
  "name": "版本信息面板",
  "version": "1.0.0",
  "api": "1",
  "author": "example",
  "steps": [
    {
      "op": "bind-slot",
      "slot": "settings.sidebar",
      "title": "关于这个版本",
      "view": "readonly-text:这里显示当前选中版本的来源文件夹、加载器与就绪度。"
    },
    {
      "op": "set-default-setting",
      "key": "checkBeforeLaunch",
      "value": true
    }
  ]
}
